#!/usr/bin/env python3
import argparse
import os
import signal

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Vte", "2.91")
from gi.repository import Gtk, Vte  # noqa: E402

parser = argparse.ArgumentParser()
parser.add_argument("--host", required=True)
parser.add_argument("--image", default="ghcr.io/fabianonunes/openfortivpn.saml.docker:0.6.0")
args, mass = parser.parse_known_args()


class App:
    window = None
    child_pid = None
    saml_opened = False

    def run(self):
        self.window = Gtk.Window(title=f"openfortivpn:{args.host}", icon_name="network-vpn")
        self.window.connect("delete-event", self.quit)
        self.window.set_default_size(640, 420)
        self.window.add(self.build_terminal())
        self.window.show_all()
        return self

    def build_cmd(self):
        priv = "env" if os.access("/var/run/docker.sock", os.W_OK | os.R_OK) else "sudo"
        return [
            f"/usr/bin/{priv}",
            "docker",
            "run",
            "--rm",
            "--network=host",
            "--device=/dev/ppp",
            "--cap-drop=ALL",
            "--cap-add=DAC_OVERRIDE",
            "--cap-add=NET_ADMIN",
            "--volume",
            "/etc/resolv.conf:/etc/resolv.conf",
            "--tty",
            "--interactive",
            args.image,
            args.host,
            "--saml-login",
            *mass,
        ]

    def quit(self, _a=None, _b=None):
        try:
            self.stop_vpn()
            Gtk.main_quit()
        except Exception as err:
            print(err)
            exit(1)

    def stop_vpn(self, _a=None, _b=None):
        if self.child_pid:
            # o openfortivpn não reage ao SIGHUP propagado pelo Vte ao sair
            os.kill(self.child_pid, signal.SIGTERM)

    def build_terminal(self):

        def on_contents_changed(term):
            if self.saml_opened:
                return

            try:
                text = term.get_text_format(Vte.Format.TEXT)
            except AttributeError:
                text, *_ = term.get_text(None)

            if text and "Listening for SAML" in text:
                self.saml_opened = True
                saml_url = f"https://{args.host}/remote/saml/start?redirect=1"
                Gtk.show_uri_on_window(self.window, saml_url, 0)

        def on_spawn(_term, pid, _error):
            self.child_pid = pid

        terminal = Vte.Terminal()
        terminal.connect("contents-changed", on_contents_changed)
        terminal.spawn_async(
            Vte.PtyFlags.DEFAULT,  # pty_flags
            None,  # working dir (herda o atual)
            self.build_cmd(),  # argv
            [],  # env
            0,  # spawn_flags: GLib.SpawnFlags.DEFAULT
            None,  # child_setup
            None,  # child_setup_data - não documentado
            -1,  # timeout
            None,  # cancellable
            on_spawn,  # callback
        )

        scroller = Gtk.ScrolledWindow()
        scroller.add(terminal)
        return scroller


if __name__ == "__main__":
    if os.geteuid() == 0:
        # evita abrir o browser como root
        raise SystemExit("erro: não execute este script como root")

    b = App().run()
    signal.signal(signal.SIGINT, b.quit)
    Gtk.main()

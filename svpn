#!/usr/bin/env python3
import argparse
import os
import signal

import gi
from cryptography import x509
from cryptography.hazmat.backends import default_backend

gi.require_version("Gtk", "3.0")
try:
    gi.require_version("WebKit2", "4.1")
except ValueError:
    gi.require_version("WebKit2", "4.0")

from gi.repository import Gtk, WebKit2  # noqa: E402

parser = argparse.ArgumentParser()
parser.add_argument("--host", required=True)
parser.add_argument(
    "--image", default="ghcr.io/fabianonunes/openfortivpn.saml.docker:0.5.0"
)
args, mass = parser.parse_known_args()


class Browser:
    window = None
    cookie = None
    terminal = None
    box = None
    trusted_cert = None

    def run(self):
        Gtk.init(None)
        self.window = Gtk.Window(title="VPN", icon_name="network-vpn")
        self.window.connect("delete-event", self.quit)
        self.window.resize(500, 570)
        self.window.show_all()
        self.connect()
        return self

    def build_cmd(self):
        priv = "env" if os.access("/var/run/docker.sock", os.W_OK | os.R_OK) else "sudo"
        cmd = (
            f"/usr/bin/{priv} docker run "
            f"--init "
            f"--rm "
            f"--network=host "
            f"--device=/dev/ppp "
            f"--cap-drop=ALL "
            f"--cap-add=DAC_OVERRIDE "
            f"--cap-add=NET_ADMIN "
            f"--volume /etc/resolv.conf:/etc/resolv.conf "
            f"--tty "
            f"--interactive "
            f"{args.image} {args.host} "
            f"--saml-login "
            f"{' '.join(mass)}"
        )
        return cmd.strip().split(" ")

    def quit(self, _a=None, _b=None):
        try:
            self.stop_container()
            self.window.destroy()
            Gtk.main_quit()
            while Gtk.events_pending():
                Gtk.main_iteration()
        except Exception as err:
            print(err)
            exit(1)

    def connect(self):
        scroller = self.build_vte()
        self.window.add(scroller)
        self.window.show_all()
        self.terminal.grab_focus()

    def stop_container(self, _a=None, _b=None):
        if not self.terminal:
            return
        # o openfortivpn não reage ao SIGHUP propagado pelo Vte ao sair
        try:
            self.terminal.feed_child(b"\x03")  # CTRL+C
        except:  # noqa
            # Ubuntu 18.04 ainda usa vte < 0.59.91
            self.terminal.feed_child("\x03", -1)  # noqa

    def build_vte(self):
        gi.require_version("Vte", "2.91")
        from gi.repository import Vte

        self._opened_urls = set()

        self.terminal = Vte.Terminal()

        saml_url = f"https://{args.host}/remote/saml/start?redirect=1"
        self._saml_opened = False

        def on_contents_changed(widget):
            if self._saml_opened:
                return
            try:
                text = widget.get_text_format(Vte.Format.TEXT)
            except Exception:
                return
            if text and "Listening for SAML" in text:
                self._saml_opened = True
                Gtk.show_uri_on_window(self.window, saml_url, 0)

        self.terminal.connect("contents-changed", on_contents_changed)

        self.terminal.spawn_async(
            Vte.PtyFlags.DEFAULT,  # pty_flags
            os.environ["HOME"],  # working_directory
            self.build_cmd(),  # argv
            [],  # envv
            0,  # spawn_flags: GLib.SpawnFlags.DEFAULT
            None,  # child_setup
            None,  # child_setup_data - não documentado
            -1,  # timeout
        )

        scroller = Gtk.ScrolledWindow()
        scroller.add(self.terminal)
        return scroller


if __name__ == "__main__":
    b = Browser().run()
    signal.signal(signal.SIGINT, b.quit)
    Gtk.main()
